{
  "name": "@mm/lib",
  "version": "0.1.0",
  "description": "Schemas, types, and other utilities used across projects.",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./common": {
      "types": "./src/common/index.ts",
      "default": "./dist/common/index.mjs"
    },
    "./customers": {
      "types": "./src/customers/index.ts",
      "default": "./dist/customers/index.mjs"
    },
    "./orders": {
      "types": "./src/orders/index.ts",
      "default": "./dist/orders/index.mjs"
    },
    "./products": {
      "types": "./src/products/index.ts",
      "default": "./dist/products/index.mjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --project unit"
  },
  "devDependencies": {
    "@mm/config": "workspace:*",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^24.10.1",
    "eslint": "^10.10.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0",
    "zod-openapi": "^6.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "sideEffects": false
}
