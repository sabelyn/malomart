{
  "name": "@mm/clients",
  "version": "0.1.0",
  "description": "AWS and other shared clients used across backend services and Lambda.",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./db": {
      "types": "./src/dbClient.ts",
      "default": "./dist/dbClient.mjs"
    },
    "./s3": {
      "types": "./src/s3Client.ts",
      "default": "./dist/s3Client.mjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --project unit"
  },
  "devDependencies": {
    "@mm/config": "workspace:*",
    "@types/node": "^24.10.1",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-vitest": "^8.0.0",
    "eslint": "^10.10.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1131.0",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/client-sqs": "^3.1132.0",
    "@aws-sdk/lib-dynamodb": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@mm/lib": "workspace:*",
    "zod": "^4.6.5"
  }
}
