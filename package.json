{
  "name": "@mm/root",
  "version": "0.1.0",
  "description": "A fantasy eShop making use of AWS services as a learning exercise.",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "format": "prettier . --write",
    "spec": "pnpm --filter api spec",
    "dev": "turbo run dev --filter=@mm/api --filter=@mm/ui --ui=stream",
    "deploy:dev": "pnpm --filter @mm/ui build && pnpm --filter @mm/infra cdk deploy \"MaloMartDev/*\" --outputs-file ../local/cdk-outputs.json && pnpm --filter @mm/api env:dev",
    "deploy:domain": "pnpm --filter @mm/infra cdk deploy MaloMartDomain MaloMartMail --outputs-file ../local/domain-outputs.json",
    "inbox": "pnpm --filter @mm/tools inbox",
    "seed": "turbo run build --filter=@mm/tools... --output-logs=errors-only && pnpm --filter @mm/tools seed",
    "backfill:orders": "turbo run build --filter=@mm/tools... --output-logs=errors-only && pnpm --filter @mm/tools backfill:orders",
    "dev:session": "turbo run build --filter=@mm/tools... --output-logs=errors-only && pnpm --filter @mm/tools dev:session",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.6",
    "turbo": "^2.11.3"
  },
  "packageManager": "pnpm@12.6.0"
}
