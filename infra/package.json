{
  "name": "@mm/infra",
  "version": "0.1.0",
  "description": "The AWS CDK app that bundles and deplys everything.",
  "scripts": {
    "build": "cdk synth",
    "check": "tsc",
    "cdk": "cdk",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1140.0",
    "@aws-sdk/client-dynamodb": "^3.1146.0",
