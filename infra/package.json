    "@mm/lib": "workspace:*",
    "@mm/ui": "workspace:*",
    "@swc/core": "^1.15.0",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^24.10.1",
    "aws-cdk": "2.1140.0",
    "aws-cdk-lib": "^2.269.0",
    "aws-jwt-verify": "^5.2.1",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-vitest": "^8.0.0",
    "constructs": "^10.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0",
    "zod": "^4.6.5"
