{
  "name": "@mm/api",
  "version": "0.1.0",
  "description": "Service for handling the public-facing API and interfacing with other AWS resources.",
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit && eslint . --fix",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "spec": "tsx ./scripts/writeSpec.ts",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "devDependencies": {
    "@aws-sdk/client-lambda": "^3.1147.0",
    "@mm/config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.0.0",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-vitest": "^8.0.0",
    "eslint": "^10.10.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1141.0",
    "@aws-sdk/client-dynamodb": "^3.1131.0",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/client-sqs": "^3.1132.0",
    "@aws-sdk/lib-dynamodb": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@mm/clients": "workspace:*",
    "@mm/lib": "workspace:*",
    "aws-jwt-verify": "^5.2.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "tsyringe": "^4.10.0",
    "zod": "^4.6.5",
    "zod-openapi": "^6.0.2"
  }
}
